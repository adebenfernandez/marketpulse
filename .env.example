# Plantilla de variables de entorno. Copia este fichero como .env y rellena los valores.
# .env está en .gitignore: NUNCA se sube a Git. Este fichero sí, porque no lleva secretos.

# Perfil de la AWS CLI creado con `aws login --profile marketpulse`
AWS_PROFILE=marketpulse
AWS_REGION=eu-north-1

# Bucket del data lake (no es secreto). Se obtiene con: terraform -chdir=infra output -raw datalake_bucket_name
MARKETPULSE_BUCKET=

# Clave Demo de CoinGecko (gratuita, opcional en local; recomendada antes de la Fase 3).
# Sin ella se usa el acceso público, con un límite por IP compartido.
COINGECKO_API_KEY=

# Clave de Alpha Vantage (gratuita, OBLIGATORIA para acciones y ETF; 25 peticiones/día).
ALPHAVANTAGE_API_KEY=

# Clave de la API de Anthropic: el agente text-to-SQL (Fase 7). Pon un límite de gasto en la Console
ANTHROPIC_API_KEY=
